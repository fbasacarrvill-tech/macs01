# ===== DATABASE =====
DATABASE_URL="postgresql://trading_user:trading_password@localhost:5432/trading_system"

# ===== JWT =====
JWT_SECRET="dev-secret-key-12345-change-in-production"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ===== BACKEND =====
BACKEND_PORT=3001
BACKEND_URL="http://localhost:3001"
NODE_ENV="development"

# ===== FRONTEND =====
FRONTEND_PORT=3000
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# ===== REDIS =====
REDIS_URL="redis://localhost:6379"

# ===== STRIPE (Payments) =====
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"
STRIPE_PRICE_PRO_MONTHLY="price_placeholder"
STRIPE_PRICE_PRO_YEARLY="price_placeholder"
STRIPE_PRICE_ELITE_MONTHLY="price_placeholder"
STRIPE_PRICE_ELITE_YEARLY="price_placeholder"
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY="price_placeholder"
NEXT_PUBLIC_STRIPE_PRICE_ELITE_MONTHLY="price_placeholder"

# ===== EMAIL (SendGrid) =====
SENDGRID_API_KEY="SG_placeholder"
SENDGRID_FROM_EMAIL="noreply@tradingsystem.com"

# ===== CORS =====
CORS_ORIGIN="http://localhost:3000"

# ===== LOGGING =====
LOG_LEVEL="debug"
