    "joi": "^17.11.0",
    "@prisma/client": "^5.3.0",
    "dotenv": "^16.3.0",
    "redis": "^4.6.0",
    "bull": "^4.11.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.3.0",
    "eslint": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^6.5.0",
    "@typescript-eslint/parser": "^6.5.0",
    "jest": "^29.7.0",
